{
  "name": "lotion",
  "author": "Lotion Team",
  "version": "1.6.0",
  "private": true,
  "description": "Unofficial Notion.so Desktop app for Linux",
  "main": "./src/main/index.js",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "electron-log": "^5.4.4",
    "electron-store": "8.2.0"
  },
  "overrides": {
    "yauzl": "^3.4.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
